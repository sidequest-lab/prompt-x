{
  "name": "prompt-x",
  "version": "0.1.0",
  "private": true,
  "description": "PromptX full-stack application",
  "scripts": {
    "frontend:dev": "pnpm --dir frontend dev",
    "frontend:build": "pnpm --dir frontend build",
    "frontend:start": "pnpm --dir frontend start",
    "frontend:lint": "pnpm --dir frontend lint",
    "backend:dev": "npm --prefix backend run dev",
    "backend:start": "npm --prefix backend run start",
    "backend:test": "npm --prefix backend run test",
    "dev": "pnpm --dir frontend dev",
    "test": "npm --prefix backend run test"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=18.18.0"
  }
}
